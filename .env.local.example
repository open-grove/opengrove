OPENGROVE_SESSION=native
OPENGROVE_WW_BASE_URL=https://opengrove.creativefitting.cn
OPENGROVE_MODEL_BASE_URL=https://your-openai-compatible-endpoint.example
OPENGROVE_MODEL_API_KEY=replace-with-your-key

# Optional service URLs for `npm run restart:desktop-dev:test`.
OPENGROVE_DESKTOP_DEV_TEST_WW_BASE_URL=
OPENGROVE_DESKTOP_DEV_TEST_RELEASE_CONTROL_URL=

# Trusted Agent Router node for admin Remote Agent conversations.
# This node receives the OpenGrove login token; configure its identity provider first.
# OPENGROVE_AGENT_ROUTER_URL=https://agents.example/_agent-router/v1
# OPENGROVE_AGENT_ROUTER_PROVIDER=opengrove
