{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenGrove Host API",
    "version": "0.1.0",
    "description": "Operations exposed through the local OpenGrove Host Protocol catalog."
  },
  "servers": [
    {
      "url": "/api",
      "description": "OpenGrove Host Bridge API base path."
    }
  ],
  "tags": [
    {
      "name": "room",
      "description": "Local Room collaboration and ledger operations."
    }
  ],
  "paths": {
    "/rooms/{roomId}/messages": {
      "post": {
        "operationId": "room.message.create",
        "summary": "Send a Room message",
        "description": "Send a user message to a Room and schedule addressed Employees.",
        "tags": ["room"],
        "x-opengrove-group": "room",
        "x-opengrove-resource": "message",
        "x-opengrove-risk": "write",
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "description": "Room identifier; surrounding whitespace is ignored.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Room identifier; surrounding whitespace is ignored."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "text": {
                    "default": "",
                    "description": "Message text.",
                    "type": "string"
                  },
                  "targetIds": {
                    "description": "Employee identifiers addressed by the message; surrounding whitespace is ignored, and empty or duplicate values are removed.",
                    "default": [],
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "attachments": {
                    "description": "Structured message attachments; null is treated as an empty list.",
                    "default": [],
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {}
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "selectedFile": {
                    "description": "Selected local file reference; null or an empty path means no selected file.",
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          }
                        },
                        "required": ["path"]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "userMessageId": {
                    "description": "Caller-provided idempotent user message identifier; surrounding whitespace is ignored.",
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "assistantMessageIds": {
                    "description": "Reserved assistant message identifiers; surrounding whitespace is ignored, and empty or duplicate values are removed.",
                    "default": [],
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inReplyToMessageId": {
                    "description": "Parent message identifier for a reply; surrounding whitespace is ignored.",
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "room": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string",
                          "enum": ["group", "direct"]
                        },
                        "title": {
                          "type": "string"
                        },
                        "badge": {
                          "type": "string"
                        },
                        "memberIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "adminMemberIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "updatedAt": {
                          "type": "string"
                        },
                        "unread": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "id",
                        "kind",
                        "title",
                        "badge",
                        "memberIds",
                        "adminMemberIds",
                        "updatedAt",
                        "unread"
                      ],
                      "additionalProperties": {}
                    },
                    "userMessage": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "roomId": {
                          "type": "string"
                        },
                        "channelSeq": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "senderId": {
                          "type": "string"
                        },
                        "senderName": {
                          "type": "string"
                        },
                        "senderType": {
                          "type": "string",
                          "enum": ["user", "agent", "system"]
                        },
                        "text": {
                          "type": "string"
                        },
                        "targetIds": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "status": {
                          "type": "string",
                          "enum": ["sent", "running", "done", "failed", "interrupted"]
                        },
                        "createdAt": {
                          "type": "string"
                        },
                        "updatedAt": {
                          "type": "string"
                        },
                        "attachments": {
                          "type": "array",
                          "items": {}
                        },
                        "parts": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          }
                        },
                        "inReplyToMessageId": {
                          "type": "string"
                        },
                        "rootMessageId": {
                          "type": "string"
                        },
                        "selectedFile": {
                          "type": "object",
                          "properties": {
                            "path": {
                              "type": "string"
                            }
                          },
                          "required": ["path"],
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "id",
                        "roomId",
                        "channelSeq",
                        "senderId",
                        "senderName",
                        "senderType",
                        "text",
                        "targetIds",
                        "status",
                        "createdAt",
                        "updatedAt"
                      ],
                      "additionalProperties": {}
                    },
                    "assistantMessages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "roomId": {
                            "type": "string"
                          },
                          "channelSeq": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "senderId": {
                            "type": "string"
                          },
                          "senderName": {
                            "type": "string"
                          },
                          "senderType": {
                            "type": "string",
                            "enum": ["user", "agent", "system"]
                          },
                          "text": {
                            "type": "string"
                          },
                          "targetIds": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "status": {
                            "type": "string",
                            "enum": ["sent", "running", "done", "failed", "interrupted"]
                          },
                          "createdAt": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string"
                          },
                          "attachments": {
                            "type": "array",
                            "items": {}
                          },
                          "parts": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "propertyNames": {
                                "type": "string"
                              },
                              "additionalProperties": {}
                            }
                          },
                          "inReplyToMessageId": {
                            "type": "string"
                          },
                          "rootMessageId": {
                            "type": "string"
                          },
                          "selectedFile": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              }
                            },
                            "required": ["path"],
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "id",
                          "roomId",
                          "channelSeq",
                          "senderId",
                          "senderName",
                          "senderType",
                          "text",
                          "targetIds",
                          "status",
                          "createdAt",
                          "updatedAt"
                        ],
                        "additionalProperties": {}
                      }
                    },
                    "currentEventSeq": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["ok", "room", "userMessage", "assistantMessages", "currentEventSeq"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request does not satisfy the operation contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string"
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": {}
                }
              }
            }
          },
          "401": {
            "description": "A valid Bridge session or token is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string"
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": {}
                }
              }
            }
          },
          "403": {
            "description": "The request origin is not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string"
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": {}
                }
              }
            }
          },
          "404": {
            "description": "The reply parent message does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string"
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": {}
                }
              }
            }
          },
          "503": {
            "description": "The authenticated session is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "traceId": {
                      "type": "string"
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    }
  }
}
