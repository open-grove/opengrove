{
  "name": "@opengrove/client",
  "version": "0.1.0",
  "type": "module",
  "description": "Typed OpenGrove Host client for first-party Web, CLI, and desktop runtimes.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "imports": {
    "#protocol": "@opengrove/protocol"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run clean && tsc6 -p tsconfig.json",
    "generate": "node ../../scripts/generate-host-client.mjs",
    "check:generated": "node ../../scripts/generate-host-client.mjs --check",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opengrove/protocol": "0.1.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
