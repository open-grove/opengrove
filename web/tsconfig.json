{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "#protocol": ["../packages/protocol/src/index.ts"],
      "@opengrove/client": ["../packages/client/src/index.ts"],
      "@opengrove/protocol": ["../packages/protocol/src/index.ts"],
      "@opengrove/agent-protocol": ["../packages/agent-protocol/src/index.ts"],
      "@opengrove/agent-protocol/locale-registry": ["../packages/agent-protocol/src/locale-registry.ts"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"]
}
